{
  "name": "bulma-deal-room",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src scripts e2e",
    "test": "vitest run",
    "build": "vite build --config vite.config.ts",
    "e2e": "playwright test",
    "oracle:selfcheck": "python3 scripts/oracle/selfcheck.py",
    "coverage:check": "vitest run --reporter=default --reporter=json --outputFile=test-report.json && playwright test && node scripts/check-coverage.mjs test-report.json e2e-report.json",
    "check:requirements": "node scripts/check-requirements.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:routes": "node --experimental-strip-types --no-warnings scripts/check-routes.ts",
    "check:outbound": "node scripts/check-outbound.mjs",
    "check:identity": "node scripts/check-identity.mjs",
    "mutation": "node scripts/mutation-check.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@pdf-lib/fontkit": "1.1.1",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "harfbuzzjs": "1.6.4",
    "nodemailer": "10.3.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsqr": "1.4.0",
    "oxlint": "^1.92.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
